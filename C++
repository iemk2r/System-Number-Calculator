void SixteenToTen() {
    cout << "\n------------------------------------\n";
    cout << "   Muunnos 16 -kantainen -> 10 -kantainen\n";
    cout << "------------------------------------\n";

    string a = isNumber(16);
    int len = a.length();
    int b = 0;

    for (int i = 0; i < len; i++) {
        if (a[i] == 'A' || a[i] == 'a')
            b += 10 * pow(16, len - i - 1);
        else if (a[i] == 'B' || a[i] == 'b')
            b += 11 * pow(16, len - i - 1);
        else if (a[i] == 'C' || a[i] == 'c')
            b += 12 * pow(16, len - i - 1);
        else if (a[i] == 'D' || a[i] == 'd')
            b += 13 * pow(16, len - i - 1);
        else if (a[i] == 'E' || a[i] == 'e')
            b += 14 * pow(16, len - i - 1);
        else if (a[i] == 'F' || a[i] == 'f')
            b += 15 * pow(16, len - i - 1);
        else
            b += (a[i] - '0') * pow(16, len - i - 1);
    }

    Result(to_string(b));
}

