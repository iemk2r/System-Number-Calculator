    }
}

int isInt() {
    int a;

    while (true) {
        cout << "\nAnna luku: ";

        if (!(cin >> a)) {
            cin.clear();
            cin.ignore(10000, '\n');

            SetConsoleTextAttribute(h, 12);
            cout << "\nVirheellinen syöte. Anna kokonaisluku.\n";
            SetConsoleTextAttribute(h, 11);
        }
        else if (a < 0) {
            SetConsoleTextAttribute(h, 12);
            cout << "\nAnna positiivinen kokonaisluku.\n";
            SetConsoleTextAttribute(h, 11);
        }
        else {
            break;
        }
    }

    return a;
}

string isNumber(int system) {
    string a = "";

    while (true) {
        cout << "\nAnna luku: ";
        cin >> a;

        bool correct = true;

        for (int i = 0; i < a.length(); i++) {
            char c = a[i];

            if (system == 2 && (c < '0' || c > '1')) {
                correct = false;
            }
            else if (system == 8 && (c < '0' || c > '7')) {
                correct = false;
            }
            else if (system == 16 &&
                !((c >= '0' && c <= '9') ||
                    (c >= 'A' && c <= 'F') ||
                    (c >= 'a' && c <= 'f'))) {
                correct = false;
            }
        }

        if (correct) {
            return a;
        }
        else {
            SetConsoleTextAttribute(h, 12);
            cout << "\nVirheellinen syöte! Yritä uudelleen.\n";
            SetConsoleTextAttribute(h, 11);
        }
    }
}

void TenToTwo() {
    cout << "\n------------------------------------\n";
    cout << "   Muunnos 10 -kantainen -> 2 -kantainen\n";
    cout << "------------------------------------\n";

    int a = isInt();
    string b = "";

    for (int i = a; i >= 1; i = i / 2) {
        b = char(i % 2 + '0') + b;
    }

    isZero(a, b);
    Result(b);
}

